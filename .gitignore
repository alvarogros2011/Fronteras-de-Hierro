# --- Godot 4 ---
# Caché generada por el editor (importaciones, shaders, etc.)
.godot/
.nomedia
# Godot 3 (por si se abre con restos antiguos)
.import/
# Ajustes locales de exportación (pueden contener credenciales)
export.cfg
export_credentials.cfg
# Traducciones importadas desde CSV
*.translation
# Mono / C# (no se usa, pero evita basura si se activa)
.mono/
data_*/
mono_crash.*.json

# NOTA: NO se ignoran *.uid ni *.import de assets: Godot 4.4+ los necesita versionados.

# --- Compilaciones exportadas ---
build/
builds/
export/
*.exe
*.pck
*.zip
*.apk
*.aab

# --- Archivos locales y temporales ---
*.tmp
*.bak
*~
~*.dll
.vscode/
.idea/
*.log

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini
